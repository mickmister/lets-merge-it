FROM lscr.io/linuxserver/code-server:4.105.1

# stay root here; LSIO entrypoint will drop privileges
# Use --allow-releaseinfo-change to handle repository mirror sync issues
RUN apt-get update --allow-releaseinfo-change-origin --allow-releaseinfo-change || apt-get update \
 && apt-get install -y --no-install-recommends unzip zsh build-essential python3 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Add custom init script to fix permissions (runs during LSIO init process)
COPY fix-permissions.sh /custom-cont-init.d/10-fix-workspace-permissions
RUN chmod +x /custom-cont-init.d/10-fix-workspace-permissions && \
    chown root:root /custom-cont-init.d/10-fix-workspace-permissions
